# ADMIT Bench — environment variables
# Copy to .env and fill in what you use. One provider key is enough;
# the stub provider needs none.

# ── Refiant (preferred) ──────────────────────────────────────────────
REFIANT_API_KEY=sk_live_your-key-here

# ── OpenRouter (works with Claude, GPT, Gemini, …) ───────────────────
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ── Anthropic direct ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Any other OpenAI-compatible gateway (provider "custom") ──────────
# ADMITBENCH_BASE_URL=https://my-gateway.example.com/v1
# ADMITBENCH_API_KEY=...

# Hard API spend cap in USD. Calls refuse to run past this. Default 10.
# ADMITBENCH_COST_CAP=10.0
